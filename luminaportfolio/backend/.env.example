# Copy to .env and fill in. Never commit the real .env.

# From Google Cloud Console (see ../docs/GOOGLE_CLOUD_SETUP.md)
LUMINA_GOOGLE_CLIENT_ID=
LUMINA_GOOGLE_CLIENT_SECRET=
LUMINA_GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/google/callback

# Scoring calibration (Phase 1 task: tune against real portraits)
LUMINA_SHARPNESS_THRESHOLD=150

# Deployment — set these in production (Render dashboard / Railway / Heroku)
# Public URL of this backend, used for building absolute URLs
LUMINA_PUBLIC_URL=http://localhost:8000
# JSON array of allowed frontend origins, e.g. '["https://your-app.vercel.app"]'
LUMINA_CORS_ORIGINS=["http://localhost:3000"]
