# --- LLM providers (optional; without any key BLITZ runs in heuristic mode) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Research data sources (optional; without a key web evidence is mocked) ---
SERPAPI_API_KEY=
NEWSAPI_KEY=

# --- Cost controls (circuit breakers) ---
MAX_ITERATIONS=3
MAX_COST_PER_QUERY=0.50
MAX_TOKENS_PER_CALL=2000
TASK_TIMEOUT_SECONDS=30
MAX_PARALLEL_WORKERS=4
CONFIDENCE_TARGET=0.7

# --- Modes ---
# Set to 1 to force full offline mode (no network calls at all)
BLITZ_OFFLINE=0
