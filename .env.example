# All keys are OPTIONAL. What you set determines your capability mode
# (check anytime with: python -m src.cli --status):
#
#   no keys                          -> Heuristic demo   (free, instant, mock evidence)
#   LLM key only                     -> LLM reasoning on mock evidence
#   SERPAPI_API_KEY only             -> Real evidence, heuristic reasoning
#   LLM key + SERPAPI_API_KEY        -> Full intelligence (real research)

# --- LLM providers (either one; OpenAI is tried first) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Research data sources ---
SERPAPI_API_KEY=
NEWSAPI_KEY=

# --- Cost controls (circuit breakers) ---
MAX_ITERATIONS=3
MAX_COST_PER_QUERY=0.50
MAX_TOKENS_PER_CALL=2000
TASK_TIMEOUT_SECONDS=30
MAX_PARALLEL_WORKERS=4
CONFIDENCE_TARGET=0.7

# --- Modes ---
# Set to 1 to force full offline mode (no network calls at all)
BLITZ_OFFLINE=0
